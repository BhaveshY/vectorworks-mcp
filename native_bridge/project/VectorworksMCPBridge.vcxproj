<?xml version="1.0" encoding="utf-8"?>
<!--
  VectorworksMCPBridge plug-in module (wire protocol v2).

  Version-controlled replacement for the SDK ObjectExample copy that used to
  live only in the git-ignored native_bridge/worktree. Sources come from
  ..\src; the Vectorworks SDK is referenced through properties so no SDK files
  are copied:

    VWVersion     2024 (default) | 2025
    VWSDKRoot     ...\third_party\VectorworksSDKExamples\VectorworksSDK\SDK$(VWVersion)
    VWThirdParty  ...\third_party\VectorworksSDKExamples\ThirdPartySource
    VWOutputRoot  .\out\$(VWVersion)\

  Build with scripts\build-native-bridge.ps1 (generates generated\BuildInfo.h
  with the git short hash + UTC build time, then runs MSBuild).
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
  </PropertyGroup>
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6E2B0F4C-6D4A-4C55-9C2E-3B1C2A7D9E10}</ProjectGuid>
    <RootNamespace>VectorworksMCPBridge</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>VectorworksMCPBridge</ProjectName>
  </PropertyGroup>
  <PropertyGroup Label="UserMacros">
    <VWVersion Condition="'$(VWVersion)'==''">2024</VWVersion>
    <VWRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))\</VWRepoRoot>
    <VWSDKRoot Condition="'$(VWSDKRoot)'==''">$(VWRepoRoot)third_party\VectorworksSDKExamples\VectorworksSDK\SDK$(VWVersion)</VWSDKRoot>
    <VWThirdParty Condition="'$(VWThirdParty)'==''">$(VWRepoRoot)third_party\VectorworksSDKExamples\ThirdPartySource</VWThirdParty>
    <VWOutputRoot Condition="'$(VWOutputRoot)'==''">$(MSBuildThisFileDirectory)out\$(VWVersion)\</VWOutputRoot>
    <VWBridgeSrc>$(MSBuildThisFileDirectory)..\src</VWBridgeSrc>
    <VWOut>$([MSBuild]::EnsureTrailingSlash('$(VWOutputRoot)'))</VWOut>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
    <Import Project="$(VWSDKRoot)\SDKLib\Include\OnlyWin\NNA_PluginBuild_RELEASE.props" />
  </ImportGroup>
  <PropertyGroup>
    <_ProjectFileVersion>10.0.30319.1</_ProjectFileVersion>
    <TargetName>VectorworksMCPBridge</TargetName>
    <TargetExt>.vlb</TargetExt>
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(VWOut)$(Configuration)\</OutDir>
    <IntDir>$(VWOut)obj\$(Configuration)\</IntDir>
    <ExternalIncludePath>$(VWSDKRoot)\SDKLib\Include;$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Midl>
      <TypeLibraryName>$(IntDir)$(TargetName).tlb</TypeLibraryName>
    </Midl>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)Source\Prefix;$(MSBuildThisFileDirectory)generated;$(VWBridgeSrc);$(VWSDKRoot)\SDKLib\Include;$(VWThirdParty)\libcurl\include\curl;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>NDEBUG;WIN32;_WINDOWS;_USRDLL;_WIN_EXTERNAL_;RELEASE_BLD;_WINDLL;CURL_STATICLIB;VWMCP_VW_VERSION=$(VWVersion);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MinimalRebuild>false</MinimalRebuild>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <SmallerTypeCheck>false</SmallerTypeCheck>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>StdAfx.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)StdAfx.pch</PrecompiledHeaderOutputFile>
      <AssemblerListingLocation>$(IntDir)</AssemblerListingLocation>
      <ObjectFileName>$(IntDir)</ObjectFileName>
      <ProgramDataBaseFileName>$(IntDir)</ProgramDataBaseFileName>
      <BrowseInformation>false</BrowseInformation>
      <WarningLevel>Level3</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <DisableSpecificWarnings>4996;4297;4467;4091;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ExceptionHandling>Sync</ExceptionHandling>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/bigobj %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <ClCompile Condition="'$(Configuration)'=='Release'">
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
    <ClCompile Condition="'$(Configuration)'=='Debug'">
      <Optimization>Disabled</Optimization>
    </ClCompile>
    <Link>
      <AdditionalDependencies>VWSDK.lib;VWMM.lib;USP10.lib;Rpcrt4.lib;libcurl.lib;Crypt32.lib;Ws2_32.lib;User32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <OutputFile>$(OutDir)$(TargetName)$(TargetExt)</OutputFile>
      <SuppressStartupBanner>true</SuppressStartupBanner>
      <AdditionalLibraryDirectories>$(VWSDKRoot)\SDKLib\LibWin\Release;$(VWThirdParty)\libcurl;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ProgramDatabaseFile>$(IntDir)$(TargetName).pdb</ProgramDatabaseFile>
      <SubSystem>Windows</SubSystem>
      <ImportLibrary>$(IntDir)$(TargetName).lib</ImportLibrary>
    </Link>
    <PostBuildEvent>
      <Command>REM Build the VWR resource archive next to the .vlb
set VWR_INPUT=$(MSBuildThisFileDirectory)VectorworksMCPBridge.vwr
set VWR_OUTPUT=$(OutDir)VectorworksMCPBridge.vwr
set VWR_MODE=$(Configuration)
set VWR_7ZCMD=$(VWSDKRoot)\SDKLib\ToolsWin\BuildVWR\7z
"$(VWSDKRoot)\SDKLib\ToolsWin\BuildVWR\buildvwr.exe"</Command>
      <Message>Creating VectorworksMCPBridge.vwr</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\Prefix\StdAfx.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="Source\ModuleMain.cpp" />
    <ClCompile Include="..\src\BimObjectHandlers.cpp" />
    <ClCompile Include="..\src\BridgeProtocol.cpp" />
    <ClCompile Include="..\src\BridgeRuntime.cpp" />
    <ClCompile Include="..\src\CapabilityRegistry.cpp" />
    <ClCompile Include="..\src\DialogWatch.cpp" />
    <ClCompile Include="..\src\Discovery.cpp" />
    <ClCompile Include="..\src\DocumentRegistry.cpp" />
    <ClCompile Include="..\src\DocumentationHandlers.cpp" />
    <ClCompile Include="..\src\GridReader.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\src\ImageTranscode.cpp">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="..\src\JsonParams.cpp" />
    <ClCompile Include="..\src\NativeIOHandlers.cpp" />
    <ClCompile Include="..\src\NativeObjectFactory.cpp" />
    <ClCompile Include="..\src\NativeTransaction.cpp" />
    <ClCompile Include="..\src\NativeTransport.cpp" />
    <ClCompile Include="..\src\OrganizationHandlers.cpp" />
    <ClCompile Include="..\src\ParametricObjectAdapter.cpp" />
    <ClCompile Include="..\src\RequestScheduler.cpp" />
    <ClCompile Include="..\src\ResourceWorksheetHandlers.cpp" />
    <ClCompile Include="..\src\ScriptEngine.cpp" />
    <ClCompile Include="..\src\SpaceObjectHandlers.cpp" />
    <ClCompile Include="..\src\UiGate.cpp" />
    <ClCompile Include="..\src\VectorworksMCPBridge.cpp" />
    <ClCompile Include="..\src\ViewCapture.cpp" />
    <ClCompile Include="..\src\ViewDocumentHandlers.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Source\Prefix\StdAfx.h" />
    <ClInclude Include="Source\Prefix\CommonPrefix.h" />
    <ClInclude Include="..\src\BimObjectHandlers.hpp" />
    <ClInclude Include="..\src\GridReader.hpp" />
    <ClInclude Include="..\src\ImageTranscode.hpp" />
    <ClInclude Include="..\src\BridgeProtocol.hpp" />
    <ClInclude Include="..\src\CapabilityRegistry.hpp" />
    <ClInclude Include="..\src\DialogWatch.hpp" />
    <ClInclude Include="..\src\Discovery.hpp" />
    <ClInclude Include="..\src\DocumentRegistry.hpp" />
    <ClInclude Include="..\src\DocumentationHandlers.hpp" />
    <ClInclude Include="..\src\JsonParams.hpp" />
    <ClInclude Include="..\src\LegacyHandlers.hpp" />
    <ClInclude Include="..\src\NativeDomain.hpp" />
    <ClInclude Include="..\src\NativeIOHandlers.hpp" />
    <ClInclude Include="..\src\NativeObjectFactory.hpp" />
    <ClInclude Include="..\src\NativeTransaction.hpp" />
    <ClInclude Include="..\src\NativeTransport.hpp" />
    <ClInclude Include="..\src\OrganizationHandlers.hpp" />
    <ClInclude Include="..\src\ParametricObjectAdapter.hpp" />
    <ClInclude Include="..\src\RequestScheduler.hpp" />
    <ClInclude Include="..\src\ResourceWorksheetHandlers.hpp" />
    <ClInclude Include="..\src\ScriptEngine.hpp" />
    <ClInclude Include="..\src\SpaceObjectHandlers.hpp" />
    <ClInclude Include="..\src\UiGate.hpp" />
    <ClInclude Include="..\src\ViewCapture.hpp" />
    <ClInclude Include="..\src\ViewDocumentHandlers.hpp" />
    <ClInclude Include="..\src\WallInserts.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
