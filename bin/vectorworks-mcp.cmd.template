@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Vectorworks MCP stdio launcher. Generated by install.ps1 from
rem bin\vectorworks-mcp.cmd.template - do not edit; rerun install.ps1.
rem Must never write to stdout: stdout carries MCP frames only.
for %%I in ("%~dp0..") do set "VW_ROOT=%%~fI"
set "VW_VER="
if exist "%VW_ROOT%\current.txt" set /p VW_VER=<"%VW_ROOT%\current.txt"
set "PYTHONUTF8=1"
set "PYTHONDONTWRITEBYTECODE="
set "PYTHONPATH="
set "PYTHONHOME="
set "PYTHONSTARTUP="
if not defined VW_MCP_STATE_DIR set "VW_MCP_STATE_DIR=%VW_ROOT%"
if not defined VW_MCP_INSTALL_COMMAND set "VW_MCP_INSTALL_COMMAND=@@INSTALL_COMMAND@@"
if not defined VW_VER goto repair_noversion
set "VW_RUNTIME=%VW_ROOT%\runtime\%VW_VER%"
if not exist "%VW_RUNTIME%\venv\Scripts\python.exe" goto repair_novenv
if not exist "%VW_RUNTIME%\app\vectorworks_mcp\__main__.py" goto repair_nocode
"%VW_RUNTIME%\venv\Scripts\python.exe" -I -X utf8 -u -m vectorworks_mcp %* & goto :eof

:repair_noversion
set "VW_MCP_REPAIR_REASON=not installed: %VW_ROOT%\current.txt is missing"
goto repair
:repair_novenv
set "VW_MCP_REPAIR_REASON=runtime %VW_VER% has no venv"
goto repair
:repair_nocode
set "VW_MCP_REPAIR_REASON=runtime %VW_VER% has no server code"
goto repair

:repair
if not exist "%~dp0repair_server.py" goto norepair
if exist "@@BASE_PYTHON@@" goto repair_base
where /q py.exe
if not errorlevel 1 goto repair_py
where /q python.exe
if not errorlevel 1 goto repair_python
goto norepair
:repair_base
"@@BASE_PYTHON@@" -I -X utf8 -u "%~dp0repair_server.py" & goto :eof
:repair_py
py.exe -3 -I -X utf8 -u "%~dp0repair_server.py" & goto :eof
:repair_python
python.exe -I -X utf8 -u "%~dp0repair_server.py" & goto :eof

:norepair
>&2 echo vectorworks-mcp: %VW_MCP_REPAIR_REASON%. No Python found to start repair mode. Install Python 3.12 from python.org and rerun install.ps1.
exit /b 3
