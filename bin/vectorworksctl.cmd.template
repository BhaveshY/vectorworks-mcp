@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem vectorworksctl - Vectorworks MCP maintenance commands. Generated by install.ps1.
rem   vectorworksctl doctor [-Json] [-Fix]   check runtime, clients, plug-in, bridge
rem   vectorworksctl repair                  rerun the installer from the installed copy
rem   vectorworksctl uninstall               remove runtime + registrations (keeps auth-token, logs)
rem   vectorworksctl launcher                print the MCP launcher path
for %%I in ("%~dp0..") do set "VW_ROOT=%%~fI"
set "VW_VER="
if exist "%VW_ROOT%\current.txt" set /p VW_VER=<"%VW_ROOT%\current.txt"
set "VW_APP=%VW_ROOT%\runtime\%VW_VER%\app"
set "VW_PS=%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe"
if /i "%~1"=="doctor" goto doctor
if /i "%~1"=="repair" goto repair
if /i "%~1"=="uninstall" goto uninstall
if /i "%~1"=="launcher" goto launcher
echo usage: vectorworksctl doctor [-Json] [-Fix] ^| repair ^| uninstall ^| launcher
exit /b 2

:launcher
echo %~dp0vectorworks-mcp.cmd
exit /b 0

:doctor
if not exist "%VW_APP%\scripts\doctor.ps1" goto missing
"%VW_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%VW_APP%\scripts\doctor.ps1" -Root "%VW_ROOT%" %*
exit /b %ERRORLEVEL%

:repair
if not exist "%VW_APP%\install.ps1" goto missing
"%VW_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%VW_APP%\install.ps1" -Root "%VW_ROOT%"
exit /b %ERRORLEVEL%

:uninstall
if not exist "%VW_APP%\install.ps1" goto missing
"%VW_PS%" -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%VW_APP%\install.ps1" -Root "%VW_ROOT%" -Uninstall
exit /b %ERRORLEVEL%

:missing
>&2 echo vectorworksctl: no installed runtime under %VW_ROOT% (current.txt="%VW_VER%"). Run install.ps1 from a clone of https://github.com/BhaveshY/vectorworks-mcp.
exit /b 3
